# Local embedded Postgres (npm run db:start).
# To use Neon instead, replace this with your Neon string and add ?sslmode=require:
#   DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/campusos?sslmode=require"
DATABASE_URL="postgresql://campus:campus@localhost:5433/campusos"

PORT=4000
NODE_ENV=development

# Change these in any non-local environment.
JWT_ACCESS_SECRET="replace-me"
JWT_REFRESH_SECRET="replace-me"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30

CORS_ORIGINS="http://localhost:5173,http://localhost:8081,http://localhost:8082,http://localhost:8083,http://localhost:19000,http://localhost:19006"

# Cloudflare Turnstile (captcha on web sign-in and sign-up). This is Cloudflare's
# always-pass TEST secret — use your real secret key in any deployed environment.
# Remove the line to switch the check off.
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
# Browser origins held to the captcha (the web app).
TURNSTILE_ORIGINS="http://localhost:5173"

# Web app address, used in password-reset emails.
APP_URL="http://localhost:5173"
# Outgoing mail for password resets (any SMTP provider). Leave unset locally:
# reset links are then printed in this server's console instead.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="you@gmail.com"
# SMTP_PASS="your-app-password"
# MAIL_FROM="Resolion Campus OS <you@gmail.com>"

# true only on the demo deployment. A real institute starts empty and is
# named by INSTITUTION_NAME / INSTITUTION_SHORT_CODE / INSTITUTION_KIND.
SEED_DEMO=true
# INSTITUTION_NAME="Sunrise Public School"
# INSTITUTION_SHORT_CODE="SPS"
# INSTITUTION_KIND="School"

# Phase 2 shared pool: one backend serving many institutes, one schema each.
# POOL_MODE=true
# POOL_ID=pool-1
# CONTROL_PLANE_URL=https://resolion-control-plane.onrender.com
# POOL_SECRET=long-random-string-shared-with-the-control-plane
# APP_URL_TEMPLATE="https://{slug}.yourdomain.com"
