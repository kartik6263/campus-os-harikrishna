// Campus OS — database schema.
//
// Built in phases, each an additive migration.
//
//   Phase 1 — authentication and the full student domain: everything the
//             mobile app and the web student portal need.
//   Phase 2 — the faculty domain: teaching load, attendance marking and
//             corrections, internal marks with an approval chain, mentoring,
//             leave and study material.
//   Phase 3 — the college office: admissions and document verification, the
//             fee counter, the certificate queue and examination-form
//             scrutiny.
//   Phase 4 — the examination back-office: sessions and centres, seat
//             allocation, evaluation with double valuation, result
//             processing under embargo, and revaluation.
//   Phase 5 — governance: the principal's dashboard and approval inbox, both
//             aggregated from the phases below rather than stored again, plus
//             teaching workload and the affiliation compliance file.
//   Phase 6 — accreditation: the NAAC, NIRF, AISHE and UGC register, where a
//             metric says whether its answer is computed from the records or
//             typed in, plus the statutory returns calendar.
//   Phase 7 — procurement: vendor empanelment, two-envelope tendering, award,
//             and the purchase order through to payment.
//   Phase 8 — right to information: applications against the statutory clock,
//             Section 8 exemptions, deemed refusal, and the two-tier appeal.
//   Phase 9 — the IT console: user administration, a permission matrix the
//             route guards actually consult, and a hash-chained audit log
//             written by the modules as they act.
//  Phase 10 — the intelligence layer: a transparent weighted risk score over
//             the records the phases above hold, snapshots so a score can be
//             compared with itself, and the interventions taken on it.
//
// Later phases add affiliation, accreditation, procurement, RTI, the IT
// console and the intelligence layer the same way.

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ─── Authentication & identity ────────────────────────────────────────────────

enum Role {
  STUDENT
  PARENT
  FACULTY
  OFFICE
  PRINCIPAL
  REGISTRAR
  ADMIN
  /// A supplier signed in to the vendor portal: its own bids and orders only.
  VENDOR
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         Role
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  /// Phase 9. A locked account cannot sign in, whatever its password.
  lockedAt           DateTime?
  lockReason         String?
  failedAttempts     Int       @default(0)
  mustChangePassword Boolean   @default(false)

  student        Student?        @relation("StudentUser")
  faculty        Faculty?        @relation("FacultyUser")
  office         OfficeStaff?    @relation("OfficeUser")
  vendor         Vendor?         @relation("VendorUser")
  refreshTokens  RefreshToken[]
  passwordResets PasswordReset[]
  auditEntries   AuditEntry[]    @relation("AuditActor")

  // A parent signs in as themselves and reads their child's record.
  wards Student[] @relation("StudentGuardian")

  identity IdentityVerification? @relation("IdentityOwner")

  @@index([role])
  @@map("users")
}

/// A "forgot password" link. Only the hash is stored; the token itself is
/// emailed once, works once, and expires.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

/// One row per issued refresh token, so a session can be revoked server-side
/// and token reuse after rotation is detectable.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  family    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
  @@map("refresh_tokens")
}

// ─── Institution ──────────────────────────────────────────────────────────────

/// Who this deployment belongs to. One row (id "default"), edited by an
/// administrator from the IT console; every client reads its name, short
/// code and contact details from here rather than from code.
model Institution {
  id          String   @id @default("default")
  name        String
  nameHi      String?
  /// Two to five letters shown in the logo mark, e.g. "RDU".
  shortCode   String
  /// University, college, school, institute — shapes wording only.
  kind        String   @default("University")
  tagline     String?
  address     String?
  city        String?
  state       String?
  pincode     String?
  country     String   @default("India")
  phone       String?
  email       String?
  website     String?
  /// The domain official accounts use, e.g. "demo.resolion.edu".
  emailDomain String?
  /// Help-desk line shown on sign-in pages.
  helpdesk    String?
  updatedAt   DateTime @updatedAt

  @@map("institution")
}

model College {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  district  String?
  createdAt DateTime @default(now())

  programmes  Programme[]
  students    Student[]
  faculty     Faculty[]
  officeStaff OfficeStaff[]
  admissions  AdmissionApplication[]
  compliance  ComplianceItem[]
  governance  GovernanceRequest[]
  returns     StatutoryReturn[]
  vendors     Vendor[]
  tenders     Tender[]
  rti         RtiApplication[]

  @@map("colleges")
}

model Programme {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  shortName String
  years     Int      @default(3)
  collegeId String?
  createdAt DateTime @default(now())

  college    College?               @relation(fields: [collegeId], references: [id])
  students   Student[]
  subjects   Subject[]
  admissions AdmissionApplication[]

  @@map("programmes")
}

model Student {
  id               String        @id @default(cuid())
  enrolmentNo      String        @unique
  rollNo           String        @unique
  name             String
  nameHi           String?
  dob              DateTime
  gender           String?
  category         String?
  semester         Int
  year             Int
  batch            String
  mobile           String?
  address          String?
  apaarId          String?       @unique
  abcId            String?       @unique
  abcCredits       Int           @default(0)
  abcTarget        Int           @default(120)
  digilockerLinked Boolean       @default(false)
  validUpto        DateTime?
  /// Where the student stands on the rolls; see StudentStatus.
  status           StudentStatus @default(ACTIVE)
  statusSince      DateTime      @default(now())
  /// Set once, when the degree requirements were certified complete.
  graduatedOn      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  userId      String  @unique
  collegeId   String
  programmeId String
  guardianId  String?

  user      User      @relation("StudentUser", fields: [userId], references: [id], onDelete: Cascade)
  college   College   @relation(fields: [collegeId], references: [id])
  programme Programme @relation(fields: [programmeId], references: [id])
  guardian  User?     @relation("StudentGuardian", fields: [guardianId], references: [id])

  enrolments          Enrolment[]
  attendanceRecords   AttendanceRecord[]
  feeItems            FeeItem[]
  feeConcessions      FeeConcession[]
  feeRefunds          FeeRefund[]
  malpracticeCases    MalpracticeCase[]
  backlogResults      BacklogResult[]
  payments            Payment[]
  instalments         Instalment[]
  scholarships        ScholarshipAward[]
  results             SemesterResult[]
  notifications       Notification[]
  busPass             BusPass?
  mentorships         Mentorship[]
  corrections         AttendanceCorrection[]
  markEntries         MarkEntry[]
  admission           AdmissionApplication?
  counterReceipts     CounterReceipt[]
  certificates        CertificateRequest[]
  examForms           ExamForm[]
  seatAllocations     SeatAllocation[]
  answerScripts       AnswerScript[]
  revaluations        RevaluationApplication[]
  riskAssessments     RiskAssessment[]
  interventions       Intervention[]
  lifecycleEvents     LifecycleEvent[]
  lifecycleRequests   LifecycleRequest[]
  clearances          NoDuesClearance[]
  digitalCertificates DigitalCertificate[]
  hostelApplications  HostelApplication[]
  hostelAllotments    HostelAllotment[]
  hostelComplaints    HostelComplaint[]
  hostelLeaves        HostelLeave[]
  hostelRoomChanges   HostelRoomChange[]
  hostelVisitors      HostelVisitor[]
  hostelRollCalls     HostelRollCallEntry[]
  transportRequests   TransportRequest[]
  tripBoardings       TripBoarding[]
  attendanceLeaves    AttendanceLeave[]
  condonations        AttendanceCondonation[]

  @@index([collegeId])
  @@index([programmeId])
  @@index([status])
  @@map("students")
}

// ─── Academics: subjects, enrolment, attendance, timetable ────────────────────

model Subject {
  id          String @id @default(cuid())
  code        String @unique
  name        String
  credits     Int
  semester    Int
  programmeId String

  programme Programme @relation(fields: [programmeId], references: [id])

  enrolments       Enrolment[]
  timetableSlots   TimetableSlot[]
  timetableChanges TimetableChange[]
  classSessions    ClassSession[]
  subjectResults   SubjectResult[]
  assignments      SubjectAssignment[]
  materials        StudyMaterial[]
  examFormRows     ExamFormSubject[]
  examPapers       ExamPaper[]

  @@index([programmeId, semester])
  @@map("subjects")
}

/// A student taking a subject in a given term, with the faculty and room.
model Enrolment {
  id        String  @id @default(cuid())
  studentId String
  subjectId String
  /// Display name, kept so student screens render without a join.
  faculty   String
  facultyId String?
  room      String
  term      String

  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject     Subject  @relation(fields: [subjectId], references: [id])
  facultyUser Faculty? @relation(fields: [facultyId], references: [id])

  @@unique([studentId, subjectId, term])
  @@map("enrolments")
}

enum Weekday {
  MON
  TUE
  WED
  THU
  FRI
  SAT
}

model TimetableSlot {
  id           String    @id @default(cuid())
  subjectId    String
  day          Weekday
  startTime    String
  endTime      String
  room         String
  faculty      String
  facultyId    String?
  term         String
  cancelled    Boolean   @default(false)
  cancelReason String?
  cancelledAt  DateTime?

  subject     Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  facultyUser Faculty?          @relation(fields: [facultyId], references: [id])
  changes     TimetableChange[]

  @@index([subjectId, day])
  @@index([facultyId, day])
  @@map("timetable_slots")
}

/// One conducted class. Attendance rows hang off this, so "held" counts are
/// derived rather than stored as a denormalised total.
model ClassSession {
  id          String    @id @default(cuid())
  subjectId   String
  date        DateTime
  startTime   String
  endTime     String
  room        String
  faculty     String
  facultyId   String?
  /// Rotating token for QR attendance; null when the window is closed.
  qrToken     String?   @unique
  qrExpiresAt DateTime?
  /// Set when faculty completes the roll call. The sheet locks
  /// `ATTENDANCE_LOCK_HOURS` after this, after which only an approved
  /// correction can change a record.
  markedAt    DateTime?
  markedById  String?

  subject     Subject                @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  facultyUser Faculty?               @relation(fields: [facultyId], references: [id])
  markedBy    Faculty?               @relation("SessionMarkedBy", fields: [markedById], references: [id])
  records     AttendanceRecord[]
  corrections AttendanceCorrection[]

  /// One roll call per slot per day, so a sheet cannot be opened twice.
  @@unique([subjectId, date, startTime])
  @@index([subjectId, date])
  @@index([facultyId, date])
  @@map("class_sessions")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model AttendanceRecord {
  id        String           @id @default(cuid())
  studentId String
  sessionId String
  status    AttendanceStatus
  markedAt  DateTime         @default(now())
  /// QR, manual (faculty), or an approved correction.
  source    String           @default("MANUAL")

  student Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([studentId, sessionId])
  @@index([studentId])
  @@map("attendance_records")
}

// ─── Finance ──────────────────────────────────────────────────────────────────

enum FeeCategory {
  TUITION
  DEVELOPMENT
  EXAM
  OTHER
}

/// A single charge on a student's account.
model FeeItem {
  id        String      @id @default(cuid())
  studentId String
  head      String
  amount    Int
  paid      Int         @default(0)
  category  FeeCategory
  term      String
  dueDate   DateTime?
  /// For a late fine: the fee head it is levied on.
  fineFor   String?

  student     Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  allocations FeeAllocation[]
  concessions FeeConcession[]
  refunds     FeeRefund[]

  @@index([studentId, term])
  @@map("fee_items")
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

/// What a ledger entry is: money received, a concession credited, or money paid back.
enum PaymentKind {
  RECEIPT
  CONCESSION
  REFUND
}

model Payment {
  id           String        @id @default(cuid())
  studentId    String
  head         String
  /// Negative for credits such as a scholarship adjustment.
  amount       Int
  mode         String
  txnId        String        @unique
  receiptNo    String?       @unique
  status       PaymentStatus @default(PENDING)
  paidAt       DateTime      @default(now())
  instalmentId String?       @unique
  kind         PaymentKind   @default(RECEIPT)
  cancelledAt  DateTime?
  cancelReason String?
  cancelledBy  String?

  student     Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  instalment  Instalment?     @relation(fields: [instalmentId], references: [id])
  receipt     CounterReceipt?
  allocations FeeAllocation[]

  @@index([studentId])
  @@map("payments")
}

model Instalment {
  id        String    @id @default(cuid())
  studentId String
  number    Int
  amount    Int
  dueDate   DateTime
  paidAt    DateTime?
  term      String

  student Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  payment Payment?

  @@unique([studentId, term, number])
  @@map("instalments")
}

model ScholarshipAward {
  id         String    @id @default(cuid())
  studentId  String
  name       String
  amount     Int
  adjusted   Boolean   @default(false)
  adjustedAt DateTime?
  term       String

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("scholarship_awards")
}

// ─── Examination results ──────────────────────────────────────────────────────

enum ResultOutcome {
  PASS
  FAIL
  WITHHELD
}

model SemesterResult {
  id           String        @id @default(cuid())
  studentId    String
  semester     Int
  declaredOn   String
  sgpa         Float
  cgpa         Float
  totalCredits Int
  outcome      ResultOutcome
  publishedAt  DateTime      @default(now())

  /// Phase 4: a result is computed before it is released. Defaults true so
  /// the results Phase 1 seeded stay visible.
  published  Boolean @default(true)
  /// Which sitting produced it; null for results that predate Phase 4.
  sessionId  String?
  division   String?
  graceMarks Int     @default(0)

  student  Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session  ExamSession?    @relation(fields: [sessionId], references: [id])
  subjects SubjectResult[]

  @@unique([studentId, semester])
  @@map("semester_results")
}

model SubjectResult {
  id         String  @id @default(cuid())
  resultId   String
  subjectId  String
  internal   Int
  external   Int
  total      Int
  grade      String
  passed     Boolean
  /// Phase 4: marks added under the grace rules, counted in the total.
  graceGiven Int     @default(0)

  result  SemesterResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  subject Subject        @relation(fields: [subjectId], references: [id])

  @@unique([resultId, subjectId])
  @@map("subject_results")
}

// ─── Notifications ────────────────────────────────────────────────────────────

enum NotificationKind {
  ATTENDANCE
  FEE
  RESULT
  EXAM
  GENERAL
}

model Notification {
  id        String           @id @default(cuid())
  studentId String
  kind      NotificationKind
  title     String
  titleHi   String?
  body      String
  bodyHi    String?
  urgent    Boolean          @default(false)
  href      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, readAt])
  @@map("notifications")
}

// ─── Transport ────────────────────────────────────────────────────────────────

/// A bus route: its stops in order, the vehicle and crew that run it.
model TransportRoute {
  id          String   @id @default(cuid())
  routeNo     String   @unique
  name        String
  vehicleId   String?
  driverId    String?
  attendantId String?
  active      Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  vehicle   Vehicle?            @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driver    TransportCrew?      @relation("RouteDriver", fields: [driverId], references: [id], onDelete: SetNull)
  attendant TransportCrew?      @relation("RouteAttendant", fields: [attendantId], references: [id], onDelete: SetNull)
  stops     RouteStop[]
  passes    BusPass[]
  requests  TransportRequest[]
  trips     TransportTrip[]
  incidents TransportIncident[]

  @@map("transport_routes")
}

model RouteStop {
  id      String @id @default(cuid())
  routeId String
  name    String
  /// Scheduled time the bus leaves this stop in the morning, "07:45".
  time    String
  order   Int
  /// Fare for a term when boarding here, in rupees: farther stops pay more.
  fare    Int    @default(0)

  passes   BusPass[]
  requests TransportRequest[]

  route TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@unique([routeId, order])
  @@map("route_stops")
}

enum BusPassStatus {
  PENDING_PAYMENT
  ACTIVE
  CANCELLED
}

/// A student's place on a route, boarding at one stop, for a term. It becomes
/// valid only once its fee is paid; `valid` mirrors ACTIVE for older readers.
model BusPass {
  id              String        @id @default(cuid())
  passNo          String        @unique
  studentId       String        @unique
  routeId         String
  stopId          String?
  term            String?
  fee             Int           @default(0)
  /// The fee head charged for this pass, so payment can be matched to it.
  feeHead         String?
  status          BusPassStatus @default(PENDING_PAYMENT)
  valid           Boolean       @default(false)
  validTill       DateTime
  issuedAt        DateTime      @default(now())
  issuedBy        String?
  cancelledReason String?

  student   Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  route     TransportRoute @relation(fields: [routeId], references: [id])
  stop      RouteStop?     @relation(fields: [stopId], references: [id], onDelete: SetNull)
  boardings TripBoarding[]

  @@index([routeId, status])
  @@map("bus_passes")
}

// ─── Announcements ────────────────────────────────────────────────────────────

enum AnnouncementScope {
  UNIVERSITY
  COLLEGE
  DEPARTMENT
  BATCH
}

model Announcement {
  id          String            @id @default(cuid())
  scope       AnnouncementScope
  title       String
  body        String
  urgent      Boolean           @default(false)
  publishedAt DateTime          @default(now())

  @@index([scope, publishedAt])
  @@map("announcements")
}

// ═══ Phase 2 — the faculty domain ═════════════════════════════════════════════

/// A member of teaching staff. The display strings on Enrolment, TimetableSlot
/// and ClassSession stay as they are; this record is what faculty endpoints
/// scope by, so one lecturer can never read another's roster or marks.
model Faculty {
  id             String   @id @default(cuid())
  employeeId     String   @unique
  /// University-wide teacher code (EMP/JU/TC/####), distinct from the
  /// college's own employee number.
  teacherCode    String?  @unique
  name           String
  nameHi         String?
  designation    String
  department     String
  mobile         String?
  joinDate       DateTime
  specialization String?
  /// Weekly teaching hours the workload rules allow.
  maxWeeklyLoad  Int      @default(18)
  /// Heads of department approve marks and leave for their department.
  isHod          Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  userId    String @unique
  collegeId String

  user    User    @relation("FacultyUser", fields: [userId], references: [id], onDelete: Cascade)
  college College @relation(fields: [collegeId], references: [id])

  assignments         SubjectAssignment[]
  enrolments          Enrolment[]
  timetableSlots      TimetableSlot[]
  classSessions       ClassSession[]
  sessionsMarked      ClassSession[]         @relation("SessionMarkedBy")
  corrections         AttendanceCorrection[] @relation("CorrectionDecidedBy")
  mentorships         Mentorship[]
  mentorNotes         MentorNote[]
  leaves              FacultyLeave[]
  leavesDecided       FacultyLeave[]         @relation("LeaveDecidedBy")
  materials           StudyMaterial[]
  sheetsDecided       MarksSheet[]           @relation("SheetDecidedBy")
  complianceReviewed  ComplianceItem[]       @relation("ComplianceReviewedBy")
  metricsUpdated      AccreditationMetric[]  @relation("MetricUpdatedBy")
  governanceRaised    GovernanceRequest[]    @relation("GovernanceRaisedBy")
  governanceDecided   GovernanceRequest[]    @relation("GovernanceDecidedBy")
  tendersRaised       Tender[]               @relation("TenderRaisedBy")
  interventionsRaised Intervention[]         @relation("InterventionRaisedBy")

  @@index([collegeId, department])
  @@map("faculty")
}

enum SubjectKind {
  THEORY
  LAB
  PROJECT
}

/// One subject taught by one lecturer to one section in one term. This is the
/// unit everything else in the faculty domain hangs off: the roster, the
/// attendance sheet and the marks sheet are all per assignment, not per
/// subject, so two sections of the same paper stay separate.
model SubjectAssignment {
  id         String      @id @default(cuid())
  facultyId  String
  subjectId  String
  term       String
  section    String      @default("A")
  /// Rendered label — "BCA V Sem A".
  classLabel String
  room       String
  kind       SubjectKind @default(THEORY)
  createdAt  DateTime    @default(now())

  faculty Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  components MarksComponent[]
  marksSheet MarksSheet?

  @@unique([facultyId, subjectId, term, section])
  @@index([subjectId, term])
  @@map("subject_assignments")
}

// ─── Attendance corrections ───────────────────────────────────────────────────

enum CorrectionStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A student disputing one day's attendance. Approving it rewrites the
/// underlying record inside a transaction, so the percentage the student sees
/// and the decision the lecturer made can never disagree.
model AttendanceCorrection {
  id              String           @id @default(cuid())
  studentId       String
  sessionId       String
  /// What the record said when the request was raised.
  markedAs        AttendanceStatus
  requestedStatus AttendanceStatus
  reason          String
  attachment      String?
  status          CorrectionStatus @default(PENDING)
  raisedAt        DateTime         @default(now())
  decidedAt       DateTime?
  decidedById     String?
  decisionNote    String?

  student   Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session   ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  decidedBy Faculty?     @relation("CorrectionDecidedBy", fields: [decidedById], references: [id])

  /// One request per student per class, so a rejected one is not re-raised.
  @@unique([studentId, sessionId])
  @@index([status, raisedAt])
  @@map("attendance_corrections")
}

// ─── Internal marks ───────────────────────────────────────────────────────────

enum MarksSheetStatus {
  NOT_STARTED
  DRAFT
  SUBMITTED
  APPROVED
  RETURNED
}

/// One scoring component — "Assignment 1", "Viva Voce". The set differs by
/// subject kind, so it is stored per assignment rather than hard-coded.
model MarksComponent {
  id           String  @id @default(cuid())
  assignmentId String
  key          String
  label        String
  maxMarks     Int
  description  String?
  order        Int     @default(0)

  assignment SubjectAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  entries    MarkEntry[]

  @@unique([assignmentId, key])
  @@map("marks_components")
}

/// The sheet a lecturer fills and the head of department approves. Its status
/// is the whole workflow: NOT_STARTED to DRAFT to SUBMITTED to APPROVED, or
/// back to RETURNED with a reason.
model MarksSheet {
  id           String           @id @default(cuid())
  assignmentId String           @unique
  status       MarksSheetStatus @default(NOT_STARTED)
  submittedAt  DateTime?
  decidedAt    DateTime?
  decidedById  String?
  returnReason String?
  updatedAt    DateTime         @updatedAt

  assignment SubjectAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  decidedBy  Faculty?          @relation("SheetDecidedBy", fields: [decidedById], references: [id])
  entries    MarkEntry[]

  @@map("marks_sheets")
}

model MarkEntry {
  id          String   @id @default(cuid())
  sheetId     String
  studentId   String
  componentId String
  /// Null means not yet scored, which is distinct from a zero.
  value       Int?
  updatedAt   DateTime @updatedAt

  sheet     MarksSheet     @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  student   Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  component MarksComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@unique([sheetId, studentId, componentId])
  @@index([sheetId, studentId])
  @@map("mark_entries")
}

// ─── Mentoring ────────────────────────────────────────────────────────────────

/// A mentor-mentee pairing. The at-risk flag and its reasons are derived from
/// live attendance and results on read, never stored, so they cannot go stale.
model Mentorship {
  id                String    @id @default(cuid())
  facultyId         String
  studentId         String
  assignedAt        DateTime  @default(now())
  lastInteractionAt DateTime?

  faculty Faculty      @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  student Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  notes   MentorNote[]

  @@unique([facultyId, studentId])
  @@map("mentorships")
}

model MentorNote {
  id           String   @id @default(cuid())
  mentorshipId String
  authorId     String
  note         String
  createdAt    DateTime @default(now())

  mentorship Mentorship @relation(fields: [mentorshipId], references: [id], onDelete: Cascade)
  author     Faculty    @relation(fields: [authorId], references: [id])

  @@index([mentorshipId, createdAt])
  @@map("mentor_notes")
}

// ─── Leave ────────────────────────────────────────────────────────────────────

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveKind {
  CASUAL
  MEDICAL
  EARNED
  STUDY
  DUTY
  MATERNITY
  UNPAID
}

model FacultyLeave {
  id           String      @id @default(cuid())
  facultyId    String
  kind         LeaveKind
  fromDate     DateTime
  toDate       DateTime
  /// Inclusive day count, computed on write so listings need no arithmetic.
  days         Int
  reason       String
  substitute   String?
  status       LeaveStatus @default(PENDING)
  appliedAt    DateTime    @default(now())
  decidedAt    DateTime?
  decidedById  String?
  decisionNote String?

  faculty   Faculty  @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  decidedBy Faculty? @relation("LeaveDecidedBy", fields: [decidedById], references: [id])

  @@index([facultyId, appliedAt])
  @@index([status])
  @@map("faculty_leaves")
}

// ─── Study material ───────────────────────────────────────────────────────────

enum MaterialType {
  PDF
  PPT
  VIDEO
  LINK
}

/// Material metadata. The bytes live wherever `url` points — this phase stores
/// no uploads, so a row without a url is a placeholder.
model StudyMaterial {
  id                String       @id @default(cuid())
  facultyId         String
  subjectId         String
  unit              Int
  unitTitle         String
  filename          String
  url               String?
  type              MaterialType
  sizeLabel         String?
  visibleToStudents Boolean      @default(true)
  uploadedAt        DateTime     @default(now())

  faculty Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([subjectId, unit])
  @@index([facultyId])
  @@map("study_materials")
}

// ═══ Phase 3 — the college office ════════════════════════════════════════════

/// Non-teaching staff: the people behind the admission, fee and certificate
/// counters. Separate from Faculty because they have no teaching load, no
/// mentees and no marks to submit — only a counter and a signature.
model OfficeStaff {
  id          String   @id @default(cuid())
  employeeId  String   @unique
  name        String
  nameHi      String?
  designation String
  /// Which window they sit at, when that is fixed.
  counter     String?
  mobile      String?
  createdAt   DateTime @default(now())

  userId    String @unique
  collegeId String

  user    User    @relation("OfficeUser", fields: [userId], references: [id], onDelete: Cascade)
  college College @relation(fields: [collegeId], references: [id])

  documentsVerified AdmissionDocument[]
  receipts          CounterReceipt[]
  rtiApplications   RtiApplication[]     @relation("RtiPio")
  appealsDecided    RtiAppeal[]          @relation("AppealDecidedBy")
  certificates      CertificateRequest[] @relation("CertificateIssuedBy")
  examFormsChecked  ExamForm[]
  governanceRaised  GovernanceRequest[]  @relation("GovernanceRaisedByStaff")

  @@index([collegeId])
  @@map("office_staff")
}

// ─── Admissions ───────────────────────────────────────────────────────────────

enum AdmissionStatus {
  PENDING_DOCS
  VERIFIED
  ENROLLED
  REJECTED
}

/// An applicant at the admission counter, before they are a student.
///
/// Becoming a Student is a deliberate step (`enrol`), not a side effect of
/// filling the form: it happens only once every required document is verified
/// and the fee is settled.
model AdmissionApplication {
  id            String          @id @default(cuid())
  applicationNo String          @unique
  name          String
  nameHi        String?
  dob           DateTime
  gender        String?
  category      String?
  mobile        String?
  email         String?
  meritRank     Int?
  admissionDate DateTime        @default(now())
  status        AdmissionStatus @default(PENDING_DOCS)
  rejectReason  String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  collegeId   String
  programmeId String
  /// Set when the application becomes a student record.
  studentId   String? @unique

  college   College   @relation(fields: [collegeId], references: [id])
  programme Programme @relation(fields: [programmeId], references: [id])
  student   Student?  @relation(fields: [studentId], references: [id])

  documents AdmissionDocument[]

  @@index([collegeId, status])
  @@map("admission_applications")
}

/// One row on the document checklist. `required` is captured per application,
/// because which papers a candidate must produce depends on their category.
model AdmissionDocument {
  id            String    @id @default(cuid())
  applicationId String
  name          String
  required      Boolean   @default(true)
  uploaded      Boolean   @default(false)
  verified      Boolean   @default(false)
  verifiedById  String?
  verifiedAt    DateTime?
  remarks       String?

  application AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  verifiedBy  OfficeStaff?         @relation(fields: [verifiedById], references: [id])

  @@unique([applicationId, name])
  @@map("admission_documents")
}

// ─── The fee counter ──────────────────────────────────────────────────────────

enum ReceiptStatus {
  COMPLETE
  PENDING_CLEARANCE
  BOUNCED
  CANCELLED
}

/// Money taken across the counter.
///
/// Every receipt writes a Payment against the student in the same transaction,
/// so a payment made at the window shows on the student's own fee screen
/// immediately — there is one ledger, not a counter ledger and an app ledger.
model CounterReceipt {
  id         String        @id @default(cuid())
  receiptNo  String        @unique
  studentId  String
  head       String
  amount     Int
  /// CASH, CHEQUE, UPI, DD, CARD, NEFT.
  mode       String
  /// Cheque number, UPI reference or DD number, as the mode requires.
  instrument String?
  status     ReceiptStatus @default(COMPLETE)
  /// Set when a cheque or DD clears, or bounces.
  settledAt  DateTime?
  receivedAt DateTime      @default(now())
  remarks    String?

  receivedById String
  paymentId    String @unique

  student    Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  receivedBy OfficeStaff @relation(fields: [receivedById], references: [id])
  payment    Payment     @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([receivedAt])
  @@map("counter_receipts")
}

// ─── Certificates ─────────────────────────────────────────────────────────────

enum CertificateStage {
  REQUESTED
  COLLEGE_OFFICE
  READY
  DISPATCHED
  REJECTED
}

enum CertificatePriority {
  NORMAL
  URGENT
}

/// A certificate a student has asked for, and the clock it is running against.
///
/// The deadline is stored rather than derived because the service standard can
/// change, and a request must keep the promise it was made under.
model CertificateRequest {
  id           String              @id @default(cuid())
  requestNo    String              @unique
  studentId    String
  type         String
  purpose      String
  priority     CertificatePriority @default(NORMAL)
  stage        CertificateStage    @default(REQUESTED)
  fee          Int                 @default(0)
  feePaid      Boolean             @default(false)
  requestedAt  DateTime            @default(now())
  slaDeadline  DateTime
  notes        String?
  issuedById   String?
  issuedAt     DateTime?
  rejectReason String?

  student  Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  issuedBy OfficeStaff?        @relation("CertificateIssuedBy", fields: [issuedById], references: [id])
  digital  DigitalCertificate?

  @@index([stage, slaDeadline])
  @@index([studentId])
  @@map("certificate_requests")
}

// ─── Examination forms ────────────────────────────────────────────────────────

enum ExamFormEligibility {
  PENDING
  ELIGIBLE
  SHORTAGE
  FEE_DUE
  CLEARED
}

/// A student's examination form, and the scrutiny it has to pass.
///
/// Eligibility is recomputed from live attendance and the fee ledger whenever
/// the form is read, so the clerk is never deciding on a stale number; the
/// stored value records what was decided, not what is currently true.
model ExamForm {
  id              String              @id @default(cuid())
  formNo          String              @unique
  studentId       String
  semester        Int
  term            String
  submittedAt     DateTime            @default(now())
  eligibility     ExamFormEligibility @default(PENDING)
  remarks         String?
  scrutinisedById String?
  scrutinisedAt   DateTime?

  student       Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  scrutinisedBy OfficeStaff?       @relation(fields: [scrutinisedById], references: [id])
  subjects      ExamFormSubject[]
  waiver        GovernanceRequest?

  @@unique([studentId, semester, term])
  @@index([eligibility])
  @@map("exam_forms")
}

enum ExamSubjectKind {
  REGULAR
  BACKLOG
}

model ExamFormSubject {
  id        String          @id @default(cuid())
  formId    String
  subjectId String
  kind      ExamSubjectKind @default(REGULAR)

  form    ExamForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  subject Subject  @relation(fields: [subjectId], references: [id])

  @@unique([formId, subjectId])
  @@map("exam_form_subjects")
}

// ═══ Phase 4 — the examination back-office ═══════════════════════════════════

enum ExamSessionStatus {
  PLANNED
  FORM_WINDOW_OPEN
  FORM_WINDOW_CLOSED
  IN_PROGRESS
  EVALUATION
  RESULT_PROCESSING
  RESULT_PUBLISHED
}

/// One examination sitting — "Nov–Dec 2024 (Odd Semester)".
///
/// The status is the session's whole lifecycle, and the back-office routes
/// refuse work that is out of step with it: scripts cannot be evaluated
/// before the papers are sat, results cannot be processed mid-evaluation.
model ExamSession {
  id           String            @id @default(cuid())
  code         String            @unique
  name         String
  academicYear String
  status       ExamSessionStatus @default(PLANNED)

  formOpensOn    DateTime
  formClosesOn   DateTime
  lateClosesOn   DateTime
  examStartsOn   DateTime
  examEndsOn     DateTime
  resultTargetOn DateTime

  regularFee Int @default(1800)
  lateFee    Int @default(500)
  backlogFee Int @default(300)

  /// Set when results are released; until then they are computed but embargoed.
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  papers      ExamPaper[]
  allocations SeatAllocation[]
  results     SemesterResult[]

  @@map("exam_sessions")
}

/// A hall students are seated in. Capacity is the number the fire officer
/// signed off, so allocation refuses to exceed it.
model ExamCentre {
  id       String  @id @default(cuid())
  code     String  @unique
  name     String
  city     String
  district String
  pincode  String?
  capacity Int

  allocations SeatAllocation[]
  bundles     AnswerBundle[]

  @@map("exam_centres")
}

model SeatAllocation {
  id          String   @id @default(cuid())
  sessionId   String
  studentId   String
  centreId    String
  seatNo      String?
  allocatedAt DateTime @default(now())

  session ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  centre  ExamCentre  @relation(fields: [centreId], references: [id])

  @@unique([sessionId, studentId])
  @@index([centreId])
  @@map("seat_allocations")
}

/// A subject's paper in a session: when it is sat, and what it is out of.
model ExamPaper {
  id           String    @id @default(cuid())
  sessionId    String
  subjectId    String
  examDate     DateTime
  examTime     String    @default("10:00–13:00")
  maxExternal  Int       @default(70)
  maxInternal  Int       @default(30)
  /// Question papers dispatched to centres under seal.
  dispatchedAt DateTime?

  session ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  subject Subject     @relation(fields: [subjectId], references: [id])

  bundles      AnswerBundle[]
  scripts      AnswerScript[]
  revaluations RevaluationApplication[]
  malpractice  MalpracticeCase[]

  @@unique([sessionId, subjectId])
  @@index([examDate])
  @@map("exam_papers")
}

enum BundleStatus {
  UNASSIGNED
  RECEIVED
  UNDER_EVALUATION
  SUBMITTED
  MODERATED
}

enum ExaminerRole {
  E1
  E2
  MODERATOR
}

/// A physical bundle of answer scripts handed to one examiner.
///
/// The bundle is how paper moves; the marks live on the script, because the
/// same script is seen by a first examiner, a second, and sometimes a
/// moderator, and all three readings have to sit side by side.
model AnswerBundle {
  id       String       @id @default(cuid())
  bundleNo String       @unique
  paperId  String
  centreId String
  status   BundleStatus @default(UNASSIGNED)

  examinerName String?
  examinerRole ExaminerRole @default(E1)
  examinerId   String?
  assignedAt   DateTime?
  submittedAt  DateTime?

  paper    ExamPaper  @relation(fields: [paperId], references: [id], onDelete: Cascade)
  centre   ExamCentre @relation(fields: [centreId], references: [id])
  examiner Examiner?  @relation(fields: [examinerId], references: [id])

  scripts AnswerScript[]

  @@index([paperId, status])
  @@map("answer_bundles")
}

/// One student's answer script for one paper.
///
/// `finalMark` is derived on submission rather than typed: the average of two
/// readings, or the moderator's when they disagree by more than the tolerance.
/// Storing it means a published result never has to re-derive itself.
model AnswerScript {
  id        String  @id @default(cuid())
  paperId   String
  studentId String
  bundleId  String?

  e1            Int?
  e2            Int?
  moderatorMark Int?
  finalMark     Int?

  /// Set when the two readings differ by more than the tolerance.
  flagged    Boolean @default(false)
  flagReason String?
  absent     Boolean @default(false)

  paper   ExamPaper     @relation(fields: [paperId], references: [id], onDelete: Cascade)
  student Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  bundle  AnswerBundle? @relation(fields: [bundleId], references: [id])

  @@unique([paperId, studentId])
  @@index([flagged])
  @@map("answer_scripts")
}

// ─── Revaluation ──────────────────────────────────────────────────────────────

enum RevaluationStatus {
  APPLIED
  UNDER_REVALUATION
  COMPLETED
  REJECTED
}

/// A challenge to a published mark.
///
/// A revaluation that changes the mark rewrites the published result, so the
/// two can never disagree; one that does not is still recorded, because the
/// student paid for the reading.
model RevaluationApplication {
  id            String            @id @default(cuid())
  applicationNo String            @unique
  studentId     String
  paperId       String
  appliedAt     DateTime          @default(now())
  fee           Int               @default(500)
  feePaid       Boolean           @default(false)
  status        RevaluationStatus @default(APPLIED)

  originalMark Int?
  revisedMark  Int?
  changed      Boolean   @default(false)
  completedAt  DateTime?
  remarks      String?

  student Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  paper   ExamPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@unique([studentId, paperId])
  @@index([status])
  @@map("revaluation_applications")
}

// ═══ Phase 5 — governance ════════════════════════════════════════════════════

enum ComplianceStatus {
  COMPLIANT
  PARTIAL
  NON_COMPLIANT
  NOT_APPLICABLE
}

/// One requirement the college is held to by a regulator.
///
/// The affiliation file is a checklist, not a score: each row names who
/// requires it, what evidence satisfies it, and when it was last looked at.
model ComplianceItem {
  id             String           @id @default(cuid())
  code           String           @unique
  category       String
  requirement    String
  /// UGC, NAAC, AICTE, or the affiliating university.
  authority      String
  status         ComplianceStatus @default(NON_COMPLIANT)
  evidence       String?
  remarks        String?
  dueOn          DateTime?
  lastReviewedAt DateTime?
  reviewedById   String?
  collegeId      String

  college    College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  reviewedBy Faculty? @relation("ComplianceReviewedBy", fields: [reviewedById], references: [id])

  @@index([collegeId, status])
  @@map("compliance_items")
}

enum GovernanceKind {
  BUDGET
  EVENT
  INFRASTRUCTURE
  PROCUREMENT
  POLICY
  EXAM_WAIVER
  OTHER
}

enum GovernanceStatus {
  PENDING
  APPROVED
  REJECTED
}

enum GovernancePriority {
  LOW
  NORMAL
  HIGH
}

/// Something that needs the principal's signature and is not a leave
/// application or a marks sheet — a budget line, an event, a building.
///
/// Leave and marks stay where they are, in the faculty domain; the approval
/// inbox gathers all three on read rather than copying them here.
model GovernanceRequest {
  id           String             @id @default(cuid())
  requestNo    String             @unique
  kind         GovernanceKind
  subject      String
  details      String
  amount       Int?
  priority     GovernancePriority @default(NORMAL)
  status       GovernanceStatus   @default(PENDING)
  raisedAt     DateTime           @default(now())
  slaDeadline  DateTime
  decidedAt    DateTime?
  decisionNote String?

  collegeId       String
  /// A faculty member, or for an office referral the clerk who raised it.
  raisedById      String?
  raisedByStaffId String?
  decidedById     String?
  /// An examination-eligibility waiver: approving it clears this form.
  examFormId      String? @unique

  college       College      @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  raisedBy      Faculty?     @relation("GovernanceRaisedBy", fields: [raisedById], references: [id])
  raisedByStaff OfficeStaff? @relation("GovernanceRaisedByStaff", fields: [raisedByStaffId], references: [id])
  examForm      ExamForm?    @relation(fields: [examFormId], references: [id], onDelete: SetNull)
  tenders       Tender[]
  decidedBy     Faculty?     @relation("GovernanceDecidedBy", fields: [decidedById], references: [id])

  @@index([collegeId, status])
  @@index([slaDeadline])
  @@map("governance_requests")
}

// ═══ Phase 6 — accreditation ═════════════════════════════════════════════════

/// A body the institution reports to: NAAC, NIRF, AISHE, the UGC.
model AccreditationFramework {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?
  /// The scoring maximum, where the framework has one (NIRF does, NAAC does not).
  maxScore    Float?

  metrics AccreditationMetric[]
  returns StatutoryReturn[]

  @@map("accreditation_frameworks")
}

enum MetricSource {
  /// Computed from the system's own records on every read.
  DERIVED
  /// Typed in, because the system does not hold what it asks for.
  ENTERED
  /// Nothing to answer it with yet, and nobody has entered it.
  UNAVAILABLE
}

/// One question a framework asks.
///
/// The point of the register is that a metric says where its answer comes
/// from. A derived metric is recomputed on read and can name the rows it
/// counted; an entered one carries a person and a date. A metric is never
/// both — hand-entering a figure the system computes is how a file stops
/// matching the records behind it.
model AccreditationMetric {
  id             String       @id @default(cuid())
  frameworkId    String
  code           String
  criterion      Int?
  criterionTitle String?
  title          String
  description    String?
  /// What the framework expects: "≥25%", "≤30:1", "All programmes".
  target         String?
  maxScore       Float?
  source         MetricSource @default(UNAVAILABLE)

  /// Names the computation that answers it, when derived.
  derivedFrom  String?
  /// The answer, when it was typed in rather than computed.
  enteredValue String?
  enteredScore Float?

  evidence    String?
  remarks     String?
  updatedById String?
  updatedAt   DateTime @updatedAt

  framework AccreditationFramework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  updatedBy Faculty?               @relation("MetricUpdatedBy", fields: [updatedById], references: [id])

  @@unique([frameworkId, code])
  @@index([frameworkId, criterion])
  @@map("accreditation_metrics")
}

/// A return the institution owes a regulator by a date.
///
/// Whether it is overdue is read off the calendar, not stored — a status
/// column would go stale the moment the date passed.
model StatutoryReturn {
  id          String    @id @default(cuid())
  frameworkId String
  code        String    @unique
  name        String
  dueOn       DateTime
  submittedOn DateTime?
  reference   String?
  remarks     String?
  collegeId   String

  framework AccreditationFramework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  college   College                @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@index([collegeId, dueOn])
  @@map("statutory_returns")
}

// ═══ Phase 7 — procurement ═══════════════════════════════════════════════════

enum VendorStatus {
  PENDING
  EMPANELLED
  BLACKLISTED
  SUSPENDED
}

/// A supplier on the university's register.
///
/// Only an empanelled vendor may bid, so this row is the gate at the front of
/// the whole process rather than a directory beside it.
model Vendor {
  id                String       @id @default(cuid())
  code              String       @unique
  name              String
  gstin             String       @unique
  pan               String
  categories        String[]
  contactName       String
  contactMobile     String
  email             String
  status            VendorStatus @default(PENDING)
  documentsVerified Boolean      @default(false)
  registeredOn      DateTime     @default(now())
  empanelledUpto    DateTime?
  statusReason      String?
  collegeId         String
  /// The supplier's own sign-in to the vendor portal, if it has one.
  userId            String?      @unique

  college College         @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  user    User?           @relation("VendorUser", fields: [userId], references: [id], onDelete: SetNull)
  bids    TenderBid[]
  orders  PurchaseOrder[]

  @@index([collegeId, status])
  @@map("vendors")
}

enum TenderStatus {
  DRAFT
  PUBLISHED
  CORRIGENDUM
  BID_OPEN
  EVALUATION
  AWARDED
  CANCELLED
}

/// A tender, from drafting to award.
///
/// Publishing requires the sanction that authorises the spend — a tender
/// floated against nothing is how money gets committed before anyone agreed
/// to it — so a tender names the approved governance request behind it.
model Tender {
  id                 String       @id @default(cuid())
  refNo              String       @unique
  title              String
  description        String
  department         String
  category           String
  estimatedValue     Int
  status             TenderStatus @default(DRAFT)
  publishedOn        DateTime?
  submissionDeadline DateTime
  openingDate        DateTime
  /// Closed when the technical stage is decided; only then may financial
  /// envelopes be opened.
  technicalClosedAt  DateTime?
  awardedBidId       String?      @unique
  cancelReason       String?
  createdAt          DateTime     @default(now())

  collegeId   String
  /// The approved PROCUREMENT request that sanctions it.
  requestId   String?
  createdById String

  college   College            @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  request   GovernanceRequest? @relation(fields: [requestId], references: [id])
  createdBy Faculty            @relation("TenderRaisedBy", fields: [createdById], references: [id])

  bids       TenderBid[]
  corrigenda TenderCorrigendum[]
  order      PurchaseOrder?

  @@index([collegeId, status])
  @@map("tenders")
}

/// A change to a published tender, which is a public act and dated as one.
model TenderCorrigendum {
  id          String    @id @default(cuid())
  tenderId    String
  description String
  newDeadline DateTime?
  issuedAt    DateTime  @default(now())

  tender Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  @@map("tender_corrigenda")
}

enum BidStatus {
  SUBMITTED
  TECHNICAL_QUALIFIED
  TECHNICAL_REJECTED
  FINANCIAL_OPENED
  RECOMMENDED
}

/// One vendor's bid, in two envelopes.
///
/// The financial quote is stored from the moment it is lodged but is not
/// disclosed by any read until the technical stage closes. That is the whole
/// integrity of a two-envelope tender: whoever scores the technical bid must
/// not know what it would cost.
model TenderBid {
  id                String    @id @default(cuid())
  tenderId          String
  vendorId          String
  submittedAt       DateTime  @default(now())
  technicalScore    Int?
  technicalRemarks  String?
  financialQuote    Int
  financialOpenedAt DateTime?
  status            BidStatus @default(SUBMITTED)
  /// The technical envelope, as the vendor lodged it from the portal.
  technicalProposal String?

  tender Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@unique([tenderId, vendorId])
  @@index([tenderId, status])
  @@map("tender_bids")
}

enum POStatus {
  ISSUED
  ACKNOWLEDGED
  PARTIAL_DELIVERY
  DELIVERED
  INSPECTED
  BILL_PASSED
  PAID
}

/// The order that follows an award, and everything that happens to it after.
///
/// The stages run one way: nothing is inspected before it is delivered, no
/// bill is passed before inspection, and nothing is paid before its bill.
model PurchaseOrder {
  id               String    @id @default(cuid())
  poNo             String    @unique
  tenderId         String    @unique
  vendorId         String
  totalAmount      Int
  issueDate        DateTime  @default(now())
  deliveryDeadline DateTime
  status           POStatus  @default(ISSUED)
  grnNo            String?
  invoiceNo        String?
  billPassedOn     DateTime?
  paymentDate      DateTime?
  paymentRef       String?
  /// Set by the vendor from the portal.
  acknowledgedAt   DateTime?
  invoiceAmount    Int?
  invoiceDate      DateTime?

  tender Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  vendor Vendor   @relation(fields: [vendorId], references: [id])
  items  POItem[]

  @@index([status])
  @@map("purchase_orders")
}

model POItem {
  id           String @id @default(cuid())
  orderId      String
  description  String
  unit         String
  quantity     Int
  unitRate     Int
  amount       Int
  deliveredQty Int    @default(0)

  order PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("po_items")
}

// ═══ Phase 8 — right to information ══════════════════════════════════════════

enum RtiStatus {
  RECEIVED
  ASSIGNED
  UNDER_PROCESS
  REPLIED
  REJECTED
  TRANSFERRED
  FIRST_APPEAL
  CIC_APPEAL
  CLOSED
}

/// An application under the Right to Information Act.
///
/// The thirty-day clock is statutory, so it is computed from the date of
/// receipt on every read rather than stored — a status column saying "on time"
/// would go stale the moment the date passed. When it lapses without a reply
/// the Act treats that as a refusal, and an appeal lies against it.
model RtiApplication {
  id               String    @id @default(cuid())
  applicationNo    String    @unique
  applicantName    String
  applicantAddress String?
  applicantEmail   String?
  subject          String
  particulars      String
  category         String
  receivedOn       DateTime  @default(now())
  /// A person below the poverty line pays no fee; everyone else pays ten rupees.
  bplExempt        Boolean   @default(false)
  feePaid          Boolean   @default(false)
  status           RtiStatus @default(RECEIVED)

  pioId      String?
  assignedAt DateTime?

  repliedOn     DateTime?
  replyText     String?
  pagesSupplied Int?
  additionalFee Int?

  rejectedOn       DateTime?
  /// The clauses of Section 8 relied on. Refusing without one is not allowed.
  rejectionGrounds String[]
  rejectionReason  String?

  transferredTo String?
  transferredOn DateTime?

  collegeId String

  college College      @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  pio     OfficeStaff? @relation("RtiPio", fields: [pioId], references: [id])
  appeals RtiAppeal[]

  @@index([collegeId, status])
  @@index([receivedOn])
  @@map("rti_applications")
}

enum AppealTier {
  FIRST
  CIC
}

enum AppealOutcome {
  PENDING
  UPHELD
  ALLOWED
  PARTIALLY_ALLOWED
}

/// An appeal against a decision, or against the absence of one.
model RtiAppeal {
  id            String        @id @default(cuid())
  appealNo      String        @unique
  applicationId String
  tier          AppealTier
  filedOn       DateTime      @default(now())
  /// Filed because the statutory period lapsed with no reply at all.
  deemedRefusal Boolean       @default(false)
  grounds       String
  outcome       AppealOutcome @default(PENDING)
  decidedOn     DateTime?
  decision      String?
  decidedById   String?

  application RtiApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  decidedBy   OfficeStaff?   @relation("AppealDecidedBy", fields: [decidedById], references: [id])

  @@unique([applicationId, tier])
  @@index([outcome])
  @@map("rti_appeals")
}

// ═══ Phase 9 — the IT console ════════════════════════════════════════════════

enum PermissionEffect {
  ALLOW
  DENY
}

/// One line of the permission matrix: what a role may do in a module.
///
/// A missing rule means allow, so the matrix is a place to *withhold* rather
/// than a list that must be complete before anything works. The route guards
/// consult this, so revoking a module here takes effect on the next request.
model PermissionRule {
  id        String           @id @default(cuid())
  role      Role
  module    String
  action    String
  effect    PermissionEffect @default(ALLOW)
  note      String?
  updatedAt DateTime         @updatedAt

  @@unique([role, module, action])
  @@index([role])
  @@map("permission_rules")
}

enum AuditOutcome {
  OK
  WARN
  DENIED
}

/// An append-only record of what was done, chained by hash.
///
/// Each entry carries the hash of the one before it, so altering or removing
/// any entry breaks every hash after it and the chain can be walked to find
/// where. Nothing here is written by hand: entries come from the modules as
/// they act.
model AuditEntry {
  id         String       @id @default(cuid())
  seq        Int          @unique @default(autoincrement())
  occurredAt DateTime     @default(now())
  actorId    String?
  actorName  String
  actorRole  String?
  module     String
  action     String
  target     String
  detail     String?
  ip         String?
  outcome    AuditOutcome @default(OK)
  /// SHA-256 over this entry's own fields plus the previous entry's hash.
  hash       String       @unique
  prevHash   String

  actor User? @relation("AuditActor", fields: [actorId], references: [id])

  @@index([module, occurredAt])
  @@index([actorId])
  @@map("audit_entries")
}

// ═══ Phase 10 — the intelligence layer ═══════════════════════════════════════

enum RiskBand {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

/// A risk score taken at a moment in time.
///
/// Scores are computed live from the records on every read, so a snapshot is
/// not the answer — it is the answer *as it stood*, kept so that a score today
/// can be compared with one from before an intervention. Without that, nobody
/// can tell whether anything helped.
model RiskAssessment {
  id         String   @id @default(cuid())
  studentId  String
  assessedAt DateTime @default(now())
  score      Int
  band       RiskBand
  /// What the score was computed from, in plain words.
  basis      String
  /// How much record there was to go on. A score from three marked sessions
  /// deserves less weight than one from forty, and hiding that would be
  /// worse than not scoring at all.
  dataPoints Int      @default(0)

  student Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  factors RiskFactorSnapshot[]

  @@index([studentId, assessedAt])
  @@index([band])
  @@map("risk_assessments")
}

/// One contributing factor, kept with the assessment that used it.
///
/// A score nobody can argue with is a score nobody should trust, so each
/// factor records what it measured, which way it pushed, and by how much.
model RiskFactorSnapshot {
  id           String @id @default(cuid())
  assessmentId String
  factor       String
  value        String
  /// Whether this pushed the score up or down.
  direction    String
  weight       Float
  contribution Int

  assessment RiskAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@map("risk_factor_snapshots")
}

enum InterventionKind {
  COUNSELLING
  PARENT_CONTACT
  REMEDIAL_CLASS
  FEE_RELIEF
  MEDICAL_REFERRAL
  OTHER
}

enum InterventionOutcome {
  OPEN
  IMPROVED
  NO_CHANGE
  WORSENED
  WITHDRAWN
}

/// Something a mentor actually did about a student the model flagged.
///
/// This is what turns a list of scores into a process: the score says who to
/// look at, the intervention says what was done, and the next snapshot says
/// whether it worked.
model Intervention {
  id           String              @id @default(cuid())
  studentId    String
  raisedById   String
  kind         InterventionKind
  note         String
  dueOn        DateTime?
  outcome      InterventionOutcome @default(OPEN)
  outcomeNote  String?
  raisedAt     DateTime            @default(now())
  closedAt     DateTime?
  /// The score when it was opened, so the change can be read off later.
  scoreAtRaise Int?

  student  Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  raisedBy Faculty @relation("InterventionRaisedBy", fields: [raisedById], references: [id])

  @@index([studentId, raisedAt])
  @@index([outcome])
  @@map("interventions")
}

// ─── Phase 11 — workspace records and stored files ───────────────────────────

/// A record kept for one of the departmental registers that have no table of
/// their own — hostel, library, grievances, placement, HR, assets, alumni and
/// the rest. Each register is a `collection`; its rows are JSON documents the
/// screen defines. Who may read and write a collection, and whether a student
/// sees only their own rows, is decided by the policy table in
/// `src/modules/records/policy.ts`, never by the client.
model WorkspaceRecord {
  id          String   @id @default(cuid())
  collection  String
  /// The document's own key (a grievance number, an asset tag), unique in its collection and scope.
  key         String
  /// The student who owns the row (their grievances, their library loans); "" for a register-wide row.
  studentId   String   @default("")
  data        Json
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([collection, studentId, key])
  @@index([collection, updatedAt])
  @@map("workspace_records")
}

/// Marks a register (or one student's share of it) as initialised, so demo
/// rows are written at most once and a register emptied on purpose stays empty.
model WorkspaceCollection {
  id            String   @id
  initializedAt DateTime @default(now())

  @@map("workspace_collections")
}

/// A file someone attached: a scanned document, a shortlist, a tender pack.
model StoredFile {
  id           String   @id @default(cuid())
  name         String
  mime         String
  size         Int
  bytes        Bytes
  /// Where it was attached, e.g. "gov:assets/AST-0012".
  context      String?
  uploadedById String?
  createdAt    DateTime @default(now())

  @@index([context])
  @@map("stored_files")
}

/// A one-time sign-in code, emailed. Only its hash is kept.
model LoginCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@map("login_codes")
}

// ═══ Identity verification — DigiLocker and the ABC ID ═══════════════════════

enum VerificationStatus {
  UNVERIFIED
  /// Submitted by hand, or DigiLocker disagreed with the record: the office decides.
  PENDING_REVIEW
  VERIFIED
  REJECTED
}

/// What DigiLocker vouched for about one person, and their Academic Bank of
/// Credits ID. Any role may verify; a student also has an ABC ID.
///
/// Only what a reviewer needs is kept: never the Aadhaar number (its last four
/// digits at most), never a DigiLocker access token.
model IdentityVerification {
  id     String @id @default(cuid())
  userId String @unique

  /// One DigiLocker account vouches for one person here, so nobody can
  /// verify a classmate's account with their own DigiLocker.
  digilockerId        String?            @unique
  dlName              String?
  /// As DigiLocker gives it, DDMMYYYY.
  dlDob               String?
  dlGender            String?
  eaadhaar            Boolean            @default(false)
  aadhaarLast4        String?
  /// null: the record had nothing to compare against.
  nameMatch           Boolean?
  dobMatch            Boolean?
  identityStatus      VerificationStatus @default(UNVERIFIED)
  /// DIGILOCKER, or DOCUMENT: an ID proof uploaded for the office to check.
  identitySource      String?
  identityDocType     String?
  identityProofFileId String?
  identityNote        String?
  verifiedAt          DateTime?
  /// The documents in the person's DigiLocker issued by others: name, issuer, date.
  documents           Json?

  abcId          String?
  /// DIGILOCKER (read from the issued ABC/APAAR card) or SELF (typed in).
  abcSource      String?
  abcStatus      VerificationStatus @default(UNVERIFIED)
  abcNote        String?
  abcProofFileId String?
  abcVerifiedAt  DateTime?

  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation("IdentityOwner", fields: [userId], references: [id], onDelete: Cascade)

  @@index([identityStatus])
  @@index([abcStatus])
  @@map("identity_verifications")
}

/// One trip to DigiLocker's consent page: the OAuth state and PKCE verifier,
/// usable once, for ten minutes, by the user who started it.
model DigilockerSession {
  id           String    @id @default(cuid())
  state        String    @unique
  codeVerifier String
  redirectUri  String
  userId       String
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@map("digilocker_sessions")
}

// ─── Student lifecycle ────────────────────────────────────────────────────────

/// Where a student stands on the rolls. Only ACTIVE students appear on class
/// rosters; the exits (WITHDRAWN, TRANSFERRED, RUSTICATED) also close the
/// sign-in, while a GRADUATED student keeps it to read their own record.
enum StudentStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  DETAINED
  WITHDRAWN
  TRANSFERRED
  RUSTICATED
  GRADUATED
}

enum LifecycleEventKind {
  ADMITTED
  PROMOTED
  DETAINED
  LEAVE_STARTED
  RESUMED
  SUSPENDED
  REINSTATED
  WITHDRAWN
  TRANSFERRED
  RUSTICATED
  READMITTED
  GRADUATED
  CLEARANCE
}

/// One entry in a student's history on the rolls. Written in the same
/// transaction as the change it records, and never edited afterwards.
model LifecycleEvent {
  id           String             @id @default(cuid())
  studentId    String
  kind         LifecycleEventKind
  fromStatus   StudentStatus?
  toStatus     StudentStatus?
  fromSemester Int?
  toSemester   Int?
  term         String?
  reason       String
  /// Order, resolution or letter number the decision was taken under.
  reference    String?
  effectiveOn  DateTime           @default(now())
  actorId      String?
  actorName    String
  createdAt    DateTime           @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@index([kind, createdAt])
  @@map("lifecycle_events")
}

enum LifecycleRequestKind {
  BREAK_OF_STUDY
  RESUME
  WITHDRAWAL
  TRANSFER
}

enum LifecycleRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// A student's own application to change their standing — a break in study,
/// a return, a withdrawal or a transfer — decided by the registrar.
model LifecycleRequest {
  id           String                 @id @default(cuid())
  requestNo    String                 @unique
  studentId    String
  kind         LifecycleRequestKind
  reason       String
  /// For a transfer, the institution the student is moving to.
  destination  String?
  /// For a break in study, when the student expects to return.
  returnBy     DateTime?
  status       LifecycleRequestStatus @default(PENDING)
  decisionNote String?
  decidedBy    String?
  decidedAt    DateTime?
  createdAt    DateTime               @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([studentId])
  @@map("lifecycle_requests")
}

/// A department's sign-off on a student leaving: the hostel warden, the
/// laboratory, the head of department. Fees, library and transport are read
/// live from their own ledgers; a row here for one of those is a waiver.
model NoDuesClearance {
  id         String   @id @default(cuid())
  studentId  String
  department String
  cleared    Boolean  @default(true)
  remarks    String?
  clearedBy  String
  clearedAt  DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, department])
  @@map("no_dues_clearances")
}

// ─── Digital certificates ─────────────────────────────────────────────────────

/// An Ed25519 key the institution signs certificates with. The newest key not
/// retired signs; every key is kept, so what an older key signed still checks.
/// The public half is published at /api/verify/keys for anyone to verify with.
model CertificateSigningKey {
  /// The key id printed on each certificate it signs.
  id         String    @id
  algorithm  String    @default("Ed25519")
  /// SPKI, PEM.
  publicKey  String
  /// PKCS#8, PEM. Null when the key is held outside the database (CERT_SIGNING_KEY).
  privateKey String?
  createdAt  DateTime  @default(now())
  retiredAt  DateTime?

  certificates DigitalCertificate[]

  @@map("certificate_signing_keys")
}

enum DigitalCertificateStatus {
  VALID
  REVOKED
}

/// A certificate the institution has issued, signed and filed.
///
/// What is signed is the canonical payload — everything printed on the
/// certificate — so changing any word of it, here or on paper, breaks the
/// signature. The official PDF is rendered once, at issue, and its SHA-256 is
/// kept, so a copy can be checked byte for byte.
model DigitalCertificate {
  id              String                   @id @default(cuid())
  serialNo        String                   @unique
  type            String
  title           String
  /// The certifying sentence, with the recipient already named.
  statement       String
  recipientName   String
  /// Enrolment number, or an external participant's own reference.
  recipientRef    String?
  recipientEmail  String?
  /// Printed as a table of label and value.
  fields          Json
  issuedAt        DateTime                 @default(now())
  validUntil      DateTime?
  issuerName      String
  issuerTitle     String
  /// The institution as named when it issued; part of what was signed.
  institutionName String
  institutionCode String
  issuedById      String?
  /// SHA-256 of the canonical payload, hex.
  payloadHash     String
  /// Ed25519 over the canonical payload, base64url.
  signature       String
  keyId           String
  fileId          String?                  @unique
  /// SHA-256 of the official PDF's bytes, hex.
  pdfHash         String?                  @unique
  status          DigitalCertificateStatus @default(VALID)
  revokedAt       DateTime?
  revokedReason   String?
  revokedBy       String?
  /// Certificates issued together (a convocation, an event) share one.
  batchRef        String?
  verifications   Int                      @default(0)
  lastVerifiedAt  DateTime?
  createdAt       DateTime                 @default(now())

  studentId String?
  requestId String? @unique

  student Student?              @relation(fields: [studentId], references: [id], onDelete: SetNull)
  request CertificateRequest?   @relation(fields: [requestId], references: [id], onDelete: SetNull)
  key     CertificateSigningKey @relation(fields: [keyId], references: [id])

  @@index([studentId])
  @@index([type, issuedAt])
  @@index([batchRef])
  @@map("digital_certificates")
}

// ─── Hostels ──────────────────────────────────────────────────────────────────

enum HostelGender {
  BOYS
  GIRLS
  CO_ED
}

enum HostelRoomStatus {
  AVAILABLE
  MAINTENANCE
  BLOCKED
}

/// A hostel the institution runs. Any number can be added; rooms belong to one.
model Hostel {
  id               String       @id @default(cuid())
  code             String       @unique
  name             String
  gender           HostelGender
  address          String?
  wardenName       String?
  wardenPhone      String?
  /// Facilities of the building: WiFi, gym, reading room, laundry…
  amenities        String[]
  rules            String?
  /// Charged per resident per month when the mess bill is run.
  messRatePerMonth Int          @default(0)
  active           Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  rooms        HostelRoom[]
  applications HostelApplication[]
  complaints   HostelComplaint[]
  visitors     HostelVisitor[]
  menu         HostelMessMenu[]
  rollCalls    HostelRollCallEntry[]
  billRuns     HostelBillRun[]

  @@map("hostels")
}

model HostelRoom {
  id              String           @id @default(cuid())
  hostelId        String
  roomNo          String
  floor           Int              @default(0)
  /// Beds in the room; never set below the residents it holds.
  capacity        Int
  ac              Boolean          @default(false)
  attachedBath    Boolean          @default(false)
  /// Furnishing of this room: bed, wardrobe, study table, fan…
  amenities       String[]
  /// Room rent per semester, per bed, in rupees.
  rentPerSemester Int              @default(0)
  status          HostelRoomStatus @default(AVAILABLE)
  notes           String?
  createdAt       DateTime         @default(now())

  hostel     Hostel             @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  allotments HostelAllotment[]
  complaints HostelComplaint[]
  changeTo   HostelRoomChange[] @relation("RoomChangeTo")

  @@unique([hostelId, roomNo])
  @@map("hostel_rooms")
}

enum HostelApplicationStatus {
  PENDING
  WAITLISTED
  ALLOTTED
  REJECTED
  CANCELLED
}

/// A student asking for a hostel place for an academic year.
model HostelApplication {
  id                String                  @id @default(cuid())
  applicationNo     String                  @unique
  studentId         String
  academicYear      String
  preferredHostelId String?
  /// SINGLE, DOUBLE, TRIPLE or ANY.
  roomPreference    String                  @default("ANY")
  distanceKm        Int                     @default(0)
  /// A medical or disability need the allotment must respect.
  specialNeeds      String?
  reason            String
  /// Worked out at application, from the allotment policy, and stored with it.
  priorityScore     Int                     @default(0)
  status            HostelApplicationStatus @default(PENDING)
  decisionNote      String?
  decidedBy         String?
  decidedAt         DateTime?
  createdAt         DateTime                @default(now())

  student         Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  preferredHostel Hostel?          @relation(fields: [preferredHostelId], references: [id], onDelete: SetNull)
  allotment       HostelAllotment?

  @@index([status, priorityScore])
  @@index([studentId])
  @@map("hostel_applications")
}

enum HostelAllotmentStatus {
  ACTIVE
  VACATED
}

/// A student in a bed. One active allotment per student and per bed is held
/// by the database itself (activeStudent and activeBed are unique while
/// active and cleared on vacating), not by the screens.
model HostelAllotment {
  id            String                @id @default(cuid())
  allotmentNo   String                @unique
  studentId     String
  roomId        String
  bed           String
  status        HostelAllotmentStatus @default(ACTIVE)
  activeStudent String?               @unique
  activeBed     String?               @unique
  academicYear  String
  allottedAt    DateTime              @default(now())
  allottedBy    String
  checkedInAt   DateTime?
  vacatedAt     DateTime?
  vacatedBy     String?
  vacateReason  String?
  applicationId String?               @unique

  student     Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  room        HostelRoom         @relation(fields: [roomId], references: [id])
  application HostelApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  roomChanges HostelRoomChange[]

  @@index([roomId, status])
  @@index([studentId])
  @@map("hostel_allotments")
}

enum HostelRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model HostelRoomChange {
  id              String              @id @default(cuid())
  requestNo       String              @unique
  studentId       String
  allotmentId     String
  preferredRoomId String?
  reason          String
  status          HostelRequestStatus @default(PENDING)
  decisionNote    String?
  decidedBy       String?
  decidedAt       DateTime?
  createdAt       DateTime            @default(now())

  student       Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  allotment     HostelAllotment @relation(fields: [allotmentId], references: [id], onDelete: Cascade)
  preferredRoom HostelRoom?     @relation("RoomChangeTo", fields: [preferredRoomId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("hostel_room_changes")
}

enum HostelComplaintStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum HostelComplaintPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model HostelComplaint {
  id          String                  @id @default(cuid())
  ticketNo    String                  @unique
  studentId   String
  hostelId    String
  roomId      String?
  category    String
  priority    HostelComplaintPriority @default(NORMAL)
  description String
  status      HostelComplaintStatus   @default(OPEN)
  assignedTo  String?
  response    String?
  /// When the service standard for this priority runs out.
  dueBy       DateTime
  resolvedAt  DateTime?
  /// The student's verdict on the fix: 1–5, with an optional word.
  rating      Int?
  feedback    String?
  reopened    Int                     @default(0)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  student Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  hostel  Hostel      @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  room    HostelRoom? @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@index([hostelId, status])
  @@index([studentId])
  @@map("hostel_complaints")
}

enum HostelLeaveKind {
  GATE_PASS
  LEAVE
}

enum HostelLeaveStatus {
  AWAITING_PARENT
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  OUT
  RETURNED
}

enum ParentConsent {
  PENDING
  GIVEN
  REFUSED
  NOT_REQUIRED
}

/// A gate pass (out and back the same day) or a leave (overnight or longer).
/// The parent consents first when a parent account is linked; the warden
/// decides; the gate records the student going out and coming back.
model HostelLeave {
  id            String            @id @default(cuid())
  passNo        String            @unique
  studentId     String
  kind          HostelLeaveKind
  leaveFrom     DateTime
  leaveTo       DateTime
  destination   String
  reason        String
  status        HostelLeaveStatus @default(PENDING)
  parentConsent ParentConsent     @default(NOT_REQUIRED)
  parentNote    String?
  decisionNote  String?
  decidedBy     String?
  decidedAt     DateTime?
  outAt         DateTime?
  returnedAt    DateTime?
  createdAt     DateTime          @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([status, leaveTo])
  @@index([studentId])
  @@map("hostel_leaves")
}

model HostelVisitor {
  id          String    @id @default(cuid())
  hostelId    String
  studentId   String
  visitorName String
  relation    String
  phone       String
  idProof     String?
  purpose     String
  inAt        DateTime  @default(now())
  outAt       DateTime?
  recordedBy  String

  hostel  Hostel  @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([hostelId, inAt])
  @@map("hostel_visitors")
}

/// The week's menu, one row per hostel and day (0 = Sunday).
model HostelMessMenu {
  id        String   @id @default(cuid())
  hostelId  String
  day       Int
  breakfast String
  lunch     String
  snacks    String   @default("")
  dinner    String
  updatedBy String?
  updatedAt DateTime @updatedAt

  hostel Hostel @relation(fields: [hostelId], references: [id], onDelete: Cascade)

  @@unique([hostelId, day])
  @@map("hostel_mess_menu")
}

enum RollCallStatus {
  PRESENT
  ABSENT
  ON_LEAVE
}

/// The night roll call: one row per resident per night.
model HostelRollCallEntry {
  id        String         @id @default(cuid())
  hostelId  String
  studentId String
  date      String
  status    RollCallStatus
  markedBy  String
  markedAt  DateTime       @default(now())

  hostel  Hostel  @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([hostelId, studentId, date])
  @@index([hostelId, date])
  @@map("hostel_roll_calls")
}

/// A run of mess or room-rent charges onto residents' fee accounts.
model HostelBillRun {
  id        String   @id @default(cuid())
  hostelId  String
  kind      String
  /// "2026-10" for mess, the term for rent.
  period    String
  rate      Int?
  charged   Int
  skipped   Int
  total     Int
  runBy     String
  createdAt DateTime @default(now())

  hostel Hostel @relation(fields: [hostelId], references: [id], onDelete: Cascade)

  @@unique([hostelId, kind, period])
  @@map("hostel_bill_runs")
}

// ─── Transport: fleet, crew, requests, trips, incidents ───────────────────────

enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  RETIRED
}

/// A vehicle in the fleet, with the papers the RTO requires it to carry.
model Vehicle {
  id                 String        @id @default(cuid())
  regNo              String        @unique
  /// BUS, MINIBUS or VAN.
  kind               String        @default("BUS")
  make               String?
  /// Seats for students; a route cannot carry more passes than this.
  capacity           Int
  /// OWNED or HIRED.
  ownership          String        @default("OWNED")
  operator           String?
  fitnessValidTill   DateTime?
  insuranceValidTill DateTime?
  permitValidTill    DateTime?
  pucValidTill       DateTime?
  gpsDeviceId        String?
  odometer           Int           @default(0)
  status             VehicleStatus @default(ACTIVE)
  notes              String?
  createdAt          DateTime      @default(now())

  routes    TransportRoute[]
  trips     TransportTrip[]
  logs      VehicleLog[]
  incidents TransportIncident[]

  @@map("vehicles")
}

enum CrewRole {
  DRIVER
  ATTENDANT
}

/// A driver or attendant. A driver's licence is checked before every trip.
model TransportCrew {
  id               String    @id @default(cuid())
  name             String
  phone            String
  role             CrewRole
  licenceNo        String?
  licenceValidTill DateTime?
  /// Police verification done on, for anyone travelling with students.
  verifiedOn       DateTime?
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())

  drives  TransportRoute[] @relation("RouteDriver")
  attends TransportRoute[] @relation("RouteAttendant")
  trips   TransportTrip[]

  @@map("transport_crew")
}

enum TransportRequestKind {
  NEW
  CHANGE
}

enum TransportRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// A student asking for a pass, or to move to another route or stop.
model TransportRequest {
  id           String                 @id @default(cuid())
  requestNo    String                 @unique
  studentId    String
  routeId      String
  stopId       String
  term         String
  kind         TransportRequestKind   @default(NEW)
  note         String?
  status       TransportRequestStatus @default(PENDING)
  decisionNote String?
  decidedBy    String?
  decidedAt    DateTime?
  createdAt    DateTime               @default(now())

  student Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  route   TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stop    RouteStop      @relation(fields: [stopId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("transport_requests")
}

enum TripStatus {
  RUNNING
  COMPLETED
  CANCELLED
}

/// One run of a route on a day: when it left each stop, and who boarded.
model TransportTrip {
  id            String     @id @default(cuid())
  routeId       String
  date          String
  /// MORNING (to campus) or EVENING (home).
  shift         String
  vehicleId     String?
  driverId      String?
  status        TripStatus @default(RUNNING)
  startedAt     DateTime   @default(now())
  endedAt       DateTime?
  odometerStart Int?
  odometerEnd   Int?
  /// The last stop the bus left, -1 before the first.
  lastStop      Int        @default(-1)
  startedBy     String
  note          String?

  route     TransportRoute      @relation(fields: [routeId], references: [id], onDelete: Cascade)
  vehicle   Vehicle?            @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driver    TransportCrew?      @relation(fields: [driverId], references: [id], onDelete: SetNull)
  events    TripStopEvent[]
  boardings TripBoarding[]
  incidents TransportIncident[]

  @@unique([routeId, date, shift])
  @@index([status])
  @@map("transport_trips")
}

model TripStopEvent {
  id           String   @id @default(cuid())
  tripId       String
  stopOrder    Int
  stopName     String
  at           DateTime @default(now())
  /// Minutes behind (positive) or ahead of the timetable; null where the run has no timetable (evenings).
  delayMinutes Int?

  trip TransportTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, stopOrder])
  @@map("trip_stop_events")
}

/// A student checked on to the bus by the attendant, by pass number.
model TripBoarding {
  id        String   @id @default(cuid())
  tripId    String
  studentId String
  passId    String
  boardedAt DateTime @default(now())
  by        String

  trip    TransportTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  student Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  pass    BusPass       @relation(fields: [passId], references: [id], onDelete: Cascade)

  @@unique([tripId, studentId])
  @@map("trip_boardings")
}

model TransportIncident {
  id            String    @id @default(cuid())
  incidentNo    String    @unique
  routeId       String?
  vehicleId     String?
  tripId        String?
  /// BREAKDOWN, ACCIDENT, DELAY, MISCONDUCT, MEDICAL, OTHER.
  kind          String
  /// LOW, MEDIUM, HIGH, CRITICAL.
  severity      String
  description   String
  location      String?
  occurredAt    DateTime
  actionTaken   String?
  status        String    @default("OPEN")
  reportedBy    String
  closedBy      String?
  closedAt      DateTime?
  ridersAlerted Int       @default(0)
  createdAt     DateTime  @default(now())

  route   TransportRoute? @relation(fields: [routeId], references: [id], onDelete: SetNull)
  vehicle Vehicle?        @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  trip    TransportTrip?  @relation(fields: [tripId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("transport_incidents")
}

/// Fuel, servicing, repairs and inspections, with what each cost.
model VehicleLog {
  id        String   @id @default(cuid())
  vehicleId String
  /// FUEL, SERVICE, REPAIR, INSPECTION, TYRE.
  kind      String
  date      DateTime
  odometer  Int?
  litres    Float?
  cost      Int      @default(0)
  vendor    String?
  notes     String?
  by        String
  createdAt DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, date])
  @@map("vehicle_logs")
}

// ─── Attendance policy, holidays, leave and condonation ───────────────────────

/// The institution's attendance rules. One row; every percentage, alert and
/// exam-eligibility check reads it, so the rule is the same on every screen.
model AttendancePolicy {
  id                  String   @id @default("default")
  /// The percentage a student must reach in each subject to sit its exam.
  threshold           Int      @default(75)
  /// Below the threshold but at or above this, the principal may condone the shortage.
  condonationFloor    Int      @default(65)
  /// Warn the student once a subject falls below this, before they are short.
  warnBelow           Int      @default(80)
  lateCountsAsPresent Boolean  @default(true)
  /// How many days back a student may apply for leave.
  leaveBackdateDays   Int      @default(15)
  updatedBy           String?
  updatedAt           DateTime @updatedAt

  @@map("attendance_policy")
}

/// A day the institution is closed; roll calls are not expected on it.
model Holiday {
  id        String   @id @default(cuid())
  /// yyyy-mm-dd on the Indian calendar.
  date      String   @unique
  name      String
  createdBy String
  createdAt DateTime @default(now())

  @@map("holidays")
}

enum AttendanceLeaveKind {
  MEDICAL
  ON_DUTY
  PERSONAL
}

enum AttendanceLeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// A student's leave from classes: illness, college duty (NSS, sports, an
/// event), or a personal reason. Approved, it turns absences in its dates
/// into excused ones — those already marked and any marked later.
model AttendanceLeave {
  id           String                @id @default(cuid())
  leaveNo      String                @unique
  studentId    String
  kind         AttendanceLeaveKind
  /// yyyy-mm-dd, inclusive.
  fromDate     String
  toDate       String
  reason       String
  proofFileId  String?
  status       AttendanceLeaveStatus @default(PENDING)
  decidedBy    String?
  decidedAt    DateTime?
  decisionNote String?
  /// Absences this leave has excused so far.
  excused      Int                   @default(0)
  createdAt    DateTime              @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([status])
  @@map("attendance_leaves")
}

enum CondonationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Permission to sit the term's exams despite a shortage between the
/// condonation floor and the threshold, granted by the principal.
model AttendanceCondonation {
  id           String            @id @default(cuid())
  requestNo    String            @unique
  studentId    String
  term         String
  /// The lowest subject percentage when the request was made.
  percent      Float
  /// MEDICAL or OTHER.
  kind         String
  reason       String
  proofFileId  String?
  /// Condonation fee charged on approval, in rupees.
  fee          Int               @default(0)
  status       CondonationStatus @default(PENDING)
  decidedBy    String?
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime          @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, term])
  @@index([status])
  @@map("attendance_condonations")
}

// ─── Timetable: dated changes, rooms, bell schedule ──────────────────────────

enum TimetableChangeKind {
  CANCEL
  ROOM
  SUBSTITUTE
  EXTRA
}

/// A change to one dated class, not to the weekly pattern: this Tuesday's
/// lecture cancelled, moved to another room, taken by a colleague, or an
/// extra (make-up) class on a day it does not normally meet.
model TimetableChange {
  id          String              @id @default(cuid())
  kind        TimetableChangeKind
  /// The weekly slot changed; null for an extra class.
  slotId      String?
  subjectId   String
  term        String
  /// yyyy-mm-dd on the Indian calendar.
  date        String
  startTime   String
  endTime     String
  room        String
  /// Who teaches this occurrence: the substitute, or the extra class's lecturer.
  facultyId   String?
  faculty     String
  reason      String
  /// An extra class held to make up for this cancellation.
  makeupForId String?
  createdBy   String
  createdById String
  createdAt   DateTime            @default(now())

  slot    TimetableSlot? @relation(fields: [slotId], references: [id], onDelete: Cascade)
  subject Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([slotId, date])
  @@index([subjectId, date])
  @@index([facultyId, date])
  @@map("timetable_changes")
}

enum RoomKind {
  CLASSROOM
  LAB
  HALL
  SEMINAR
  OTHER
}

/// A teaching room. Timetable slots name rooms by code.
model Room {
  id        String   @id @default(cuid())
  code      String   @unique
  building  String   @default("")
  capacity  Int      @default(60)
  kind      RoomKind @default(CLASSROOM)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("rooms")
}

/// The institution's bell schedule: the periods classes are timetabled in.
model BellPeriod {
  id        String  @id @default(cuid())
  label     String
  startTime String  @unique
  endTime   String
  isBreak   Boolean @default(false)

  @@map("bell_periods")
}

// ─── Fee ledger: allocations, structures, concessions, refunds, day close ────

/// Which fee head a ledger entry paid (or credited), and by how much. Lets a
/// receipt be cancelled exactly, and a statement say what each rupee settled.
model FeeAllocation {
  id        String   @id @default(cuid())
  paymentId String
  feeItemId String
  amount    Int
  createdAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  feeItem FeeItem @relation(fields: [feeItemId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([feeItemId])
  @@map("fee_allocations")
}

/// A programme-semester's fees for a term: the heads and the instalment plan.
model FeeStructure {
  id          String    @id @default(cuid())
  name        String
  programmeId String
  semester    Int
  term        String
  /// [{ head, category, amount, dueDate }]
  heads       Json
  /// [{ percent, dueDate }] — empty for pay-in-full.
  instalments Json      @default("[]")
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  appliedAt   DateTime?
  appliedTo   Int       @default(0)

  @@unique([programmeId, semester, term])
  @@map("fee_structures")
}

enum ConcessionKind {
  MERIT
  NEED_BASED
  SIBLING
  STAFF_WARD
  SPORTS
  SCHOLARSHIP
  OTHER
}

enum FeeDecision {
  PENDING
  APPROVED
  REJECTED
}

/// A concession or waiver on one fee head: asked for by the office, decided
/// by the registrar or principal, and credited to the head when approved.
model FeeConcession {
  id           String         @id @default(cuid())
  concessionNo String         @unique
  studentId    String
  feeItemId    String
  kind         ConcessionKind
  amount       Int
  reason       String
  proofFileId  String?
  status       FeeDecision    @default(PENDING)
  requestedBy  String
  decidedBy    String?
  decidedAt    DateTime?
  decisionNote String?
  paymentId    String?
  createdAt    DateTime       @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeItem FeeItem @relation(fields: [feeItemId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("fee_concessions")
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PAID
  REJECTED
}

/// Money paid back on a fee head — a caution deposit, a withdrawn admission.
model FeeRefund {
  id           String       @id @default(cuid())
  refundNo     String       @unique
  studentId    String
  feeItemId    String
  amount       Int
  reason       String
  status       RefundStatus @default(REQUESTED)
  requestedBy  String
  decidedBy    String?
  decidedAt    DateTime?
  decisionNote String?
  payoutMode   String?
  payoutRef    String?
  paidBy       String?
  paidAt       DateTime?
  paymentId    String?
  createdAt    DateTime     @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeItem FeeItem @relation(fields: [feeItemId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("fee_refunds")
}

/// The cash book closed for a day: what the counter should hold, what was counted.
model FeeDayClose {
  id           String   @id @default(cuid())
  date         String   @unique
  expectedCash Int
  countedCash  Int
  difference   Int
  totals       Json
  remarks      String?
  closedBy     String
  closedAt     DateTime @default(now())

  @@map("fee_day_closes")
}

// ─── Examinations: examiners, malpractice, backlog results ──────────────────

/// An examiner on the university's evaluation panel.
model Examiner {
  id          String   @id @default(cuid())
  name        String
  designation String
  institution String
  subjects    String   @default("")
  mobile      String?
  email       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  bundles AnswerBundle[]

  @@map("examiners")
}

enum UfmStatus {
  REPORTED
  DECIDED
}

enum UfmDecision {
  WARNING
  PAPER_CANCELLED
  SESSION_CANCELLED
  DEBARRED
}

/// An unfair-means (malpractice) case reported from the examination hall.
model MalpracticeCase {
  id             String       @id @default(cuid())
  caseNo         String       @unique
  sessionId      String
  paperId        String
  studentId      String
  description    String
  evidenceFileId String?
  reportedBy     String
  status         UfmStatus    @default(REPORTED)
  decision       UfmDecision?
  decisionNote   String?
  decidedBy      String?
  decidedAt      DateTime?
  createdAt      DateTime     @default(now())

  paper   ExamPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  student Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([paperId, studentId])
  @@index([sessionId])
  @@map("malpractice_cases")
}

/// A backlog paper re-sat in a later sitting: held under embargo with the
/// sitting's results, and written into the original semester's marksheet
/// when the sitting is published.
model BacklogResult {
  id        String   @id @default(cuid())
  sessionId String
  studentId String
  subjectId String
  semester  Int
  internal  Int
  external  Int
  total     Int
  grade     String
  passed    Boolean
  applied   Boolean  @default(false)
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId, subjectId])
  @@map("backlog_results")
}
